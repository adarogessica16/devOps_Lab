pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'devopsv2',
                    url: 'https://github.com/adarogessica16/devOps_Lab.git'
            }
        }

        stage('Build Backend') {
            steps {
                dir('backend') {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }
    }

    post {
        success {
            echo 'BUILD SUCCESS'

            build job: 'registros-gastos-push'
        }
    }
}
